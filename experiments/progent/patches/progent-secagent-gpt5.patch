+def _is_fixed_temperature_model(name: str) -> bool:
+    """gpt-5 / o-series reasoning models reject every temperature except the default."""
+    return name.startswith(("gpt-5", "o1", "o3", "o4"))
+
+
+def _record_usage(completion, sys_prompt: str, model: str) -> None:
+    """[local patch] Optional token accounting: if SECAGENT_USAGE_LOG is set, append one JSON line per call."""
+    path = os.getenv("SECAGENT_USAGE_LOG")
+    usage = getattr(completion, "usage", None)
+    if not path or usage is None:
+        return
+    try:
+        if sys_prompt.startswith("Your task is to set permissions"):
+            kind = "policy_generate"
+        elif sys_prompt.startswith("Your task is to determine whether"):
+            kind = "policy_update_decision"
+        elif sys_prompt.startswith("Your task is to update the restrictions"):
+            kind = "policy_update"
+        else:
+            kind = "policy_other"
+        details = getattr(usage, "completion_tokens_details", None)
+        pdetails = getattr(usage, "prompt_tokens_details", None)
+        rec = {
+            "kind": kind,
+            "model": model,
+            "prompt_tokens": usage.prompt_tokens,
+            "completion_tokens": usage.completion_tokens,
+            "reasoning_tokens": getattr(details, "reasoning_tokens", 0) or 0,
+            "cached_tokens": getattr(pdetails, "cached_tokens", 0) or 0,
+        }
+        with open(path, "a") as f:
+            f.write(json.dumps(rec) + "\n")
+    except Exception:
+        pass
+
+
+def _chat_create(client, **kwargs):
+    """[local patch] chat.completions.create that never sends `temperature` to models that reject it
+    (gpt-5*, o1*, o3*, o4*), and drops `temperature`/`seed` once if the API rejects them anyway."""
+    from openai import BadRequestError
+    if _is_fixed_temperature_model(kwargs["model"]):
+        kwargs.pop("temperature", None)
+    completion = None
+    for _ in range(3):
+        try:
+            completion = client.chat.completions.create(**kwargs)
+            break
+        except BadRequestError as e:
+            msg = str(e).lower()
+            dropped = False
+            for param in ("temperature", "seed"):
+                if param in kwargs and param in msg:
+                    kwargs.pop(param)
+                    dropped = True
+            if not dropped:
+                raise
+    _record_usage(completion, kwargs["messages"][0]["content"], kwargs["model"])
+    return completion
+
+
